# Qloo hackathon key (required for live mode; without it the app runs on mock data)
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_MOCK=1            # force mock mode even with a key

# Gemini (optional). Without it the scripted planner builds the plan.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite
# GEMINI_TIMEOUT=20      # seconds before falling back to the scripted planner
